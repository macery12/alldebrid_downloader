<Window x:Class="AllDebridDownloader.Views.FileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File already exists"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">

    <StackPanel Margin="20">

        <TextBlock Text="File already exists" Style="{StaticResource Heading}" FontSize="16"/>

        <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="On disk:" Style="{StaticResource SubtleText}"/>
            <TextBlock Grid.Column="1" x:Name="ExistingText"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Incoming:" Style="{StaticResource SubtleText}"/>
            <TextBlock Grid.Column="1" x:Name="IncomingText"/>
        </Grid>

        <CheckBox x:Name="ApplyToAll" Margin="0,16,0,0"
                  Content="Do this for all remaining files in this batch"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Skip" MinWidth="90" Click="OnSkip"/>
            <Button Content="Rename" MinWidth="90" Margin="8,0,0,0" Click="OnRename"/>
            <Button Content="Overwrite" MinWidth="100" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="OnOverwrite"/>
        </StackPanel>

    </StackPanel>
</Window>
